<section class="page-view">

    <header class="page-header">

        <div>
            <span class="section-eyebrow">
                IOC Management
            </span>

            <h1>IOC Explorer</h1>

            <p class="panel-description">
                Carga, consulta, filtra y exporta los indicadores
                almacenados en la plataforma.
            </p>
        </div>

    </header>

    <div class="ioc-workspace">

        <section class="panel">

            <div class="panel-header">

                <div>
                    <h2>Upload IOC CSV</h2>

                    <p class="panel-description">
                        Incorpora nuevos indicadores a la plataforma.
                    </p>
                </div>

            </div>

            <div class="upload-zone">

                <strong>
                    Arrastra tu archivo CSV aquí
                </strong>

                <span>
                    o selecciónalo manualmente
                </span>

            </div>

            <input
                type="file"
                id="archivo"
                accept=".csv,text/csv"
            >

            <button
                type="button"
                id="subir-archivo"
                class="upload-button"
            >
                Subir archivo
            </button>

            <p class="upload-help">
                Formato soportado: CSV
            </p>

            <div id="resultado"></div>

        </section>

        <section class="panel">

            <div class="panel-header">

                <div>

                    <h2>Filtros</h2>

                    <p class="panel-description">
                        Refina los resultados del repositorio.
                    </p>

                </div>

                <button
                    type="button"
                    id="exportar-iocs"
                    class="button-secondary"
                >
                    Exportar CSV
                </button>

            </div>

            <div class="ioc-filters">

                <div class="filter-field">

                    <label for="ioc-search">
                        Buscar IOC
                    </label>

                    <input
                        type="search"
                        id="ioc-search"
                        placeholder="IP, dominio, URL, hash, campaña o malware"
                        autocomplete="off"
                    >

                </div>

                <div class="filter-field">

                    <label for="ioc-tipo">
                        Tipo
                    </label>

                    <select id="ioc-tipo">
                        <option value="">Todos</option>
                        <option value="ip">IP</option>
                        <option value="domain">Dominio</option>
                        <option value="url">URL</option>
                        <option value="hash">Hash</option>
                    </select>

                </div>

                <div class="filter-field">

                    <label for="ioc-estado">
                        Estado
                    </label>

                    <select id="ioc-estado">
                        <option value="">Todos</option>
                        <option value="malicious">Malicioso</option>
                        <option value="suspicious">Sospechoso</option>
                        <option value="clean">Limpio</option>
                        <option value="pending">Pendiente</option>
                        <option value="error">Error</option>
                    </select>

                </div>

                <div class="filter-field">

                    <label for="ioc-fuente">
                        Fuente
                    </label>

                    <input
                        type="text"
                        id="ioc-fuente"
                        placeholder="Ej. SOCradar"
                        autocomplete="off"
                    >

                </div>

                <div class="filter-field">

                    <label for="ioc-campaign">
                        Campaña
                    </label>

                    <input
                        type="text"
                        id="ioc-campaign"
                        placeholder="Ej. Akira"
                        autocomplete="off"
                    >

                </div>

                <div class="filter-field">

                    <label for="ioc-malware-family">
                        Familia de malware
                    </label>

                    <input
                        type="text"
                        id="ioc-malware-family"
                        placeholder="Ej. Lumma"
                        autocomplete="off"
                    >

                </div>

                <div class="filter-field">

                    <label for="ioc-date-from">
                        Fecha inicial
                    </label>

                    <input
                        type="date"
                        id="ioc-date-from"
                    >

                </div>

                <div class="filter-field">

                    <label for="ioc-date-to">
                        Fecha final
                    </label>

                    <input
                        type="date"
                        id="ioc-date-to"
                    >

                </div>

                <div class="filter-field">

                    <label for="ioc-page-size">
                        Registros por página
                    </label>

                    <select id="ioc-page-size">
                        <option value="10">10</option>
                        <option value="25" selected>25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>

                </div>

                <div class="filter-actions">

                    <button
                        type="button"
                        id="aplicar-filtros"
                    >
                        Aplicar filtros
                    </button>

                    <button
                        type="button"
                        id="limpiar-filtros"
                        class="button-secondary"
                    >
                        Limpiar
                    </button>

                </div>

            </div>

            <div
                id="ioc-error"
                class="table-message table-message-error"
                role="alert"
                hidden
            ></div>

        </section>

    </div>

    <section class="panel">

        <div class="panel-header">

            <div>
                <h2>Indicadores almacenados</h2>

                <p class="panel-description">
                    Resultados encontrados en el repositorio.
                </p>
            </div>

        </div>

        <div class="table-wrapper">

            <table>

                <thead>

                    <tr>
                        <th>Tipo</th>
                        <th>IOC</th>
                        <th>Campaña</th>
                        <th>Malware</th>
                        <th>Estado</th>
                        <th>Score</th>
                        <th>Malicious</th>
                        <th>Suspicious</th>
                        <th>Fuente</th>
                        <th>Última consulta</th>
                    </tr>

                </thead>

                <tbody id="tabla">

                    <tr>
                        <td
                            colspan="10"
                            class="empty-state"
                        >
                            Cargando IOC...
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

        <div class="pagination">

            <div id="ioc-pagination-info">
                Mostrando 0 registros
            </div>

            <div class="pagination-actions">

                <button
                    type="button"
                    id="pagina-anterior"
                    class="button-secondary"
                    disabled
                >
                    Anterior
                </button>

                <span id="ioc-page-number">
                    Página 1
                </span>

                <button
                    type="button"
                    id="pagina-siguiente"
                    class="button-secondary"
                    disabled
                >
                    Siguiente
                </button>

            </div>

        </div>

    </section>

</section>
