<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>IOC Platform</title>

    <link
        rel="stylesheet"
        href="/static/css/main.css"
    >
    <link rel="stylesheet" href="/static/css/enrichment-control.css?v=20260803-1">
</head>

<body>

    <div class="container">

        <aside class="sidebar">

            <div class="sidebar-brand">
                <h2>IOC Platform</h2>

                <span>
                    Cyber Threat Intelligence
                </span>
            </div>

            <nav class="sidebar-navigation">

                <a
                    href="#/dashboard"
                    class="nav-link"
                    data-route="/dashboard"
                >
                    <span class="nav-icon">⌂</span>
                    <span>Dashboard</span>
                </a>

                            <a
                href="#/uploads"
                data-route="/uploads"
            >
                <span>Upload Intelligence</span>
            </a>

<a
                    href="#/explorer"
                    class="nav-link"
                    data-route="/explorer"
                >
                    <span class="nav-icon">⌕</span>
                    <span>IOC Explorer</span>
                </a>

                <a
                    href="#/analysis"
                    class="nav-link"
                    data-route="/analysis"
                >
                    <span class="nav-icon">▤</span>
                    <span>Analysis</span>
                </a>

                <div class="nav-group">

                    <button
                        type="button"
                        id="threat-intelligence-toggle"
                        class="nav-group-toggle"
                        aria-expanded="false"
                        aria-controls="threat-intelligence-submenu"
                    >
                        <span class="nav-group-label">
                            <span class="nav-icon">◎</span>
                            <span>Threat Intelligence</span>
                        </span>

                        <span class="nav-chevron">
                            ▸
                        </span>
                    </button>

                    <div
                        id="threat-intelligence-submenu"
                        class="nav-submenu"
                        hidden
                    >

                        <a
                            href="#/threat-intelligence/dashboard"
                            class="nav-link nav-submenu-link"
                            data-route="/threat-intelligence/dashboard"
                        >
                            Threat Dashboard
                        </a>

                        <a
                            href="#/threat-intelligence/statistics"
                            class="nav-link nav-submenu-link"
                            data-route="/threat-intelligence/statistics"
                        >
                            IOC Statistics
                        </a>

                        <a
                            href="#/threat-intelligence/campaigns"
                            class="nav-link nav-submenu-link"
                            data-route="/threat-intelligence/campaigns"
                        >
                            Campaigns
                        </a>

                        <a
                            href="#/threat-intelligence/malware"
                            class="nav-link nav-submenu-link"
                            data-route="/threat-intelligence/malware"
                        >
                            Malware
                        </a>

                        <a
                            href="#/threat-intelligence/actors"
                            class="nav-link nav-submenu-link"
                            data-route="/threat-intelligence/actors"
                        >
                            Threat Actors
                        </a>

                        <a
                            href="#/threat-intelligence/sources"
                            class="nav-link nav-submenu-link"
                            data-route="/threat-intelligence/sources"
                        >
                            Sources
                        </a>

                        <a
                            href="#/threat-intelligence/feeds"
                            class="nav-link nav-submenu-link"
                            data-route="/threat-intelligence/feeds"
                        >
                            Feeds
                        </a>

                    </div>

                </div>

                <a
                    href="#/hunting"
                    class="nav-link"
                    data-route="/hunting"
                >
                    <span class="nav-icon">⌖</span>
                    <span>Threat Hunting</span>
                </a>

                <a
                    href="#/reports"
                    class="nav-link"
                    data-route="/reports"
                >
                    <span class="nav-icon">▥</span>
                    <span>Reports</span>
                </a>

                <a
                    href="#/integrations"
                    class="nav-link"
                    data-route="/integrations"
                >
                    <span class="nav-icon">⛓</span>
                    <span>Integrations</span>
                </a>

                <a
                    href="#/settings"
                    class="nav-link"
                    data-route="/settings"
                >
                    <span class="nav-icon">⚙</span>
                    <span>Settings</span>
                </a>

            </nav>

            <div class="sidebar-footer">
                <span class="system-status-dot"></span>
                Plataforma operativa
            </div>

        </aside>

        <main class="content">

            <div
                id="view-loading"
                class="view-loading"
                hidden
            >
                Cargando módulo...
            </div>

            <div
                id="view-error"
                class="view-error"
                role="alert"
                hidden
            ></div>

            <div id="app-view"></div>

        </main>

    </div>

    <script
        type="module"
        src="/static/js/app.js?v=20260803-6"
    ></script>

</body>

</html>
