from fastapi import FastAPI, UploadFile, File
from fastapi.responses import HTMLResponse
from fastapi.staticfiles import StaticFiles
from sqlalchemy import create_engine, text
from datetime import datetime
import os
import csv
import re


app = FastAPI(title="IOC Platform")


# ==============================
# DATABASE
# ==============================

DB_HOST = "postgres"

DB_NAME = os.getenv("POSTGRES_DB", "cyberintel")
DB_USER = os.getenv("POSTGRES_USER", "cyberintel")
DB_PASSWORD = os.getenv("POSTGRES_PASSWORD", "SuperPassword123")


DATABASE_URL = (
    f"postgresql://{DB_USER}:{DB_PASSWORD}@{DB_HOST}:5432/{DB_NAME}"
)


engine = create_engine(DATABASE_URL)


# ==============================
# STATIC
# ==============================

app.mount(
    "/static",
    StaticFiles(directory="static"),
    name="static"
)


# ==============================
# HOME
# ==============================

@app.get("/", response_class=HTMLResponse)
def home():

    with open("static/index.html", "r") as f:
        return f.read()



# ==============================
# HEALTH
# ==============================

@app.get("/health")
def health():

    return {
        "status":"ok"
    }



# ==============================
# STATS
# ==============================

@app.get("/api/stats")
def stats():

    query = """
    SELECT
        COUNT(*) AS total,
        COUNT(*) FILTER (WHERE malicious > 0) AS maliciosos,
        COUNT(*) FILTER (WHERE suspicious > 0 AND malicious = 0) AS sospechosos,
        COUNT(*) FILTER (WHERE malicious = 0 AND suspicious = 0) AS limpios
    FROM iocs;
    """


    with engine.connect() as conn:

        row = conn.execute(text(query)).fetchone()


    return {

        "total_iocs": row.total,
        "maliciosos": row.maliciosos,
        "sospechosos": row.sospechosos,
        "limpios": row.limpios

    }



# ==============================
# DETECTAR TIPO IOC
# ==============================

def detectar_tipo(valor):

    valor = valor.strip()


    if re.match(r"^\d{1,3}(\.\d{1,3}){3}$", valor):

        return "ip"


    if re.match(r"^[a-fA-F0-9]{32}$", valor):

        return "md5"


    if re.match(r"^[a-fA-F0-9]{40}$", valor):

        return "sha1"


    if re.match(r"^[a-fA-F0-9]{64}$", valor):

        return "sha256"


    return "domain"



# ==============================
# UPLOAD CSV IOC
# ==============================

@app.post("/api/upload")
async def upload_ioc(file: UploadFile = File(...)):


    contenido = await file.read()


    ruta = f"/uploads/{file.filename}"


    with open(ruta,"wb") as f:

        f.write(contenido)



    analysis_id = None


    with engine.begin() as conn:


        result = conn.execute(

            text("""
            INSERT INTO analysis
            (
                nombre_archivo,
                estado,
                total_iocs
            )
            VALUES
            (
                :archivo,
                'procesando',
                0
            )
            RETURNING id
            """),

            {
                "archivo":file.filename
            }

        )


        analysis_id = result.fetchone()[0]



    total = 0



    with open(ruta, newline="", encoding="utf-8") as csvfile:


        reader = csv.DictReader(csvfile)


        for row in reader:


            valor = (
                row.get("ioc")
                or row.get("valor")
                or row.get("src_ip")
            )


            if not valor:

                continue


            tipo = detectar_tipo(valor)



            with engine.begin() as conn:


                conn.execute(

                    text("""
                    INSERT INTO iocs
                    (
                        tipo,
                        valor,
                        fuente,
                        proveedor_reputacion,
                        vt_estado,
                        analysis_id
                    )

                    VALUES

                    (
                        :tipo,
                        :valor,
                        :fuente,
                        'Pendiente',
                        'pendiente',
                        :analysis
                    )

                    ON CONFLICT(valor)
                    DO UPDATE SET
                    analysis_id = EXCLUDED.analysis_id,
                    fuente = EXCLUDED.fuente
                    """),

                    {

                    "tipo":tipo,
                    "valor":valor,
                    "fuente":file.filename,
                    "analysis":analysis_id

                    }

                )


            total += 1



    with engine.begin() as conn:

        conn.execute(

            text("""
            UPDATE analysis

            SET
            estado='finalizado',
            total_iocs=:total,
            analizados=:total,
            fecha_fin=CURRENT_TIMESTAMP

            WHERE id=:id
            """),

            {
                "total":total,
                "id":analysis_id
            }

        )



    return {

        "status":"ok",
        "analysis_id":analysis_id,
        "iocs_cargados":total

    }




# ==============================
# IOC MALICIOSOS
# ==============================

@app.get("/api/iocs/malicious")
def malicious_iocs():


    query="""

    SELECT

    tipo,
    valor,
    malicious,
    suspicious,
    harmless,
    proveedor_reputacion,
    vt_estado

    FROM iocs

    WHERE malicious > 0

    ORDER BY malicious DESC

    LIMIT 100;

    """


    with engine.connect() as conn:

        rows = conn.execute(text(query)).fetchall()



    return [

    {

    "tipo":r.tipo,
    "valor":r.valor,
    "malicious":r.malicious,
    "suspicious":r.suspicious,
    "harmless":r.harmless,
    "proveedor":r.proveedor_reputacion,
    "estado":r.vt_estado

    }

    for r in rows

    ]


# ==============================
# HISTORIAL DE ANALISIS
# ==============================

@app.get("/api/analysis/history")
def analysis_history():


    query = """

    SELECT

        id,
        nombre_archivo,
        estado,
        fecha_inicio,
        fecha_fin,
        total_iocs,
        analizados,
        maliciosos,
        sospechosos,
        limpios,
        errores

    FROM analysis

    ORDER BY id DESC

    LIMIT 50;

    """


    with engine.connect() as conn:

        rows = conn.execute(
            text(query)
        ).fetchall()



    return [

        {

            "id": r.id,
            "archivo": r.nombre_archivo,
            "estado": r.estado,
            "fecha_inicio": str(r.fecha_inicio),
            "fecha_fin": str(r.fecha_fin),
            "total_iocs": r.total_iocs,
            "analizados": r.analizados,
            "maliciosos": r.maliciosos,
            "sospechosos": r.sospechosos,
            "limpios": r.limpios,
            "errores": r.errores

        }

        for r in rows

    ]

