# ==========================================================
# IOC Platform
# Environment Configuration
# ==========================================================

# ==========================
# PostgreSQL
# ==========================

POSTGRES_DB=cyberintel
POSTGRES_USER=cyberintel
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# ==========================
# API
# ==========================

API_HOST=0.0.0.0
API_PORT=8000

# ==========================
# Nginx
# ==========================

NGINX_PORT=80

# ==========================
# Adminer
# ==========================

ADMINER_PORT=8080

# ==========================
# VirusTotal
# ==========================

VT_API_KEY=YOUR_VIRUSTOTAL_API_KEY

# ==========================
# Collector
# ==========================

COLLECTOR_INTERVAL_SECONDS=60
COLLECTOR_BATCH_SIZE=25
COLLECTOR_MAX_RETRIES=3

# ==========================
# Logging
# ==========================

LOG_LEVEL=INFO

# ==========================
# Application
# ==========================

APP_NAME=IOC Platform
APP_VERSION=0.3.0-alpha
APP_ENV=development

# ==========================
# Future Integrations
# ==========================

THEHIVE_URL=
THEHIVE_API_KEY=

CORTEX_URL=
CORTEX_API_KEY=

SPLUNK_URL=
SPLUNK_TOKEN=

FORTIGATE_URL=
FORTIGATE_TOKEN=

INTEL471_API_KEY=

SOCRADAR_API_KEY=